# Database (PostgreSQL)
# Use Supabase, Neon, or Railway for managed PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/perth_split?schema=public"

# NextAuth.js
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# Google OAuth (optional - for Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OCR Options (choose one)
# Option 1: Google Cloud Vision (more accurate, requires API key)
GOOGLE_CLOUD_VISION_API_KEY=""

# Option 2: Tesseract.js (free, runs locally - no API key needed)
# Just leave GOOGLE_CLOUD_VISION_API_KEY empty to use Tesseract

# OpenAI (optional - for smart receipt parsing)
OPENAI_API_KEY=""

# PayPal (optional - for PayPal payment links)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# App Configuration
# Your PayID for receiving payments (email or phone format)
DEFAULT_PAYID=""

# BSB and Account Number for bank transfers (optional)
DEFAULT_BSB=""
DEFAULT_ACCOUNT_NUMBER=""
DEFAULT_ACCOUNT_NAME=""
